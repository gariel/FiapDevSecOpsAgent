{
  "entities": {
    "Scan": {
      "title": "Scan",
      "description": "A capture of a security scan execution.",
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "commitHash": { "type": "string" },
        "author": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "summary": { "type": "object" },
        "findingsCount": { "type": "integer" },
        "criticalCount": { "type": "integer" },
        "highCount": { "type": "integer" }
      },
      "required": ["owner", "repo", "branch", "commitHash", "timestamp"]
    },
    "Finding": {
      "title": "Finding",
      "description": "A specific security vulnerability found in a scan.",
      "type": "object",
      "properties": {
        "scanId": { "type": "string" },
        "filePath": { "type": "string" },
        "lineNumber": { "type": "integer" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "category": { "type": "string" },
        "githubUrl": { "type": "string" }
      },
      "required": ["scanId", "filePath", "description", "severity"]
    }
  },
  "firestore": {
    "/scans/{scanId}": {
      "schema": "Scan",
      "description": "Collection of security scans."
    },
    "/scans/{scanId}/findings/{findingId}": {
      "schema": "Finding",
      "description": "Findings associated with a specific scan."
    }
  }
}
